## 플레이그라운드
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
# Swift Package Manager 의존성의 소스 코드를 커밋하지 않으려면 이 줄을 추가한다.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
# Xcode가 .xcworkspacedata 파일과 xcuserdata를 포함한 이 디렉터리를 자동으로 생성하므로
# 프로젝트에 패키지 설정 파일을 추가한 경우가 아니면 이 디렉터리는 필요하지 않다
# .swiftpm

.build/

# CocoaPods
# Pods 디렉터리를 .gitignore에 추가하지 않는 것을 권장한다. 다만
