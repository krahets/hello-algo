{% import 'icons.html.j2' as icons %}
<!-- Generated from the shared homepage template and locale configuration. -->
<link rel="stylesheet" href="{{ runtime('hero-motion.css') }}">
<noscript><style>[data-home-src], video[data-home-poster], [data-hero-fallback] { display: none; }</style></noscript>
<section data-md-color-scheme="slate" data-md-color-primary="grey" class="home-div home-universe-bg">
  <div class="starfield"><div class="starfield-origin"></div></div>
  <div class="{{ locale.hero_class }}" data-home-layout="universe">
  {% for object in objects %}
    {% if object.href %}<a href="{{ object.href }}">{% endif %}
    <img {{ hero_image(object.id)|safe }} alt="" style="{{ object.style }}; aspect-ratio: {{ assets[object.id].width }} / {{ assets[object.id].height }}">
    {% if object.id.startswith('chapter_') %}<noscript><img {{ image(object.id)|safe }} alt="" style="{{ object.style }}"></noscript>{% endif %}
    {% if object.href %}<span style="{{ locale.label_styles[object.id] }}">{{ locale.labels[object.id] }}</span></a>{% endif %}
  {% endfor %}
  </div>
  <div class="heading-div">
    <img style="{{ locale.typing.style }}" src="{{ locale.typing.src }}" alt="{{ locale.typing.alt }}" loading="lazy">
    <div>
      <p style="margin-top: max(-1vh, -2vw); margin-bottom: min(2vh, 3.5vw);">{{ locale.tagline }}</p>
      <a href="{{ locale.start_href }}" class="rounded-button">{{ icons.read() }}<span>{{ locale.start_label }}</span></a>
      <a href="https://github.com/krahets/hello-algo" class="rounded-button">{{ icons.github() }}<span>GitHub</span></a>
    </div>
    <div style="text-align: center; margin-top: min(2.5vh, 3.5vw);">{{ icons.arrow() }}</div>
  </div>
</section>
<section data-md-color-scheme="slate" data-md-color-primary="grey" class="home-div">
  <div class="section-content">
    <div class="reading-media">
    {% for card in locale.reading %}
      <div class="media-block"><a href="{{ card.href }}">
        {% if card.spacers %}<div style="{{ card.spacers[0] }}"></div>{% endif %}
        <img class="device-on-hover" style="{{ card.image_style }}" {{ image(card.asset, true)|safe }} alt="{{ card.alt }}" decoding="async">
        <noscript><img class="device-on-hover" style="{{ card.image_style }}" {{ image(card.asset)|safe }} alt="{{ card.alt }}" loading="lazy"></noscript>
        {% if card.spacers|length > 1 %}<div style="{{ card.spacers[1] }}"></div>{% endif %}
        <div class="text-button"><span>{{ card.label }}</span>{{ icons.chevron() }}</div>
      </a></div>
    {% endfor %}
    </div>
    {% for note in locale.reading_notes %}<p style="{{ note.style }}">{{ note.text }}</p>{% endfor %}
    <p style="margin-top: 2em;">{{ locale.reading_description }}</p>
  </div>
</section>
<section data-md-color-scheme="slate" data-md-color-primary="grey" class="home-div">
  <div class="section-content">
    <h3 style="text-align: center; margin: 1em auto;">{{ locale.endorsement_title }}</h3>
    <div class="intro-container endor-container">
    {% for quote, author in locale.endorsements %}
      <div class="intro-text endor-text"><p style="margin-bottom: 0;">{{ quote }}</p><p style="font-weight: bold;">{{ author }}</p></div>
    {% endfor %}
    </div>
  </div>
</section>
{% macro feature_text(feature, i) %}
  <div class="intro-text"><div>
    <div style="display: flex; align-items: center;">{{ icons['feature_' ~ i]() }}<h3 style="margin-left: 0.5em;">{{ feature.title }}</h3></div>
    <p style="margin: 0;">{{ feature.description }}</p>
    <p class="intro-quote">{% for line in feature.quotes %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
  </div></div>
{% endmacro %}
<section data-md-color-scheme="slate" data-md-color-primary="grey" class="home-div">
  <div class="section-content">
  {% for feature in locale.features %}
    <div class="intro-container">
      {% if loop.index0 != 1 %}{{ feature_text(feature, loop.index0) }}{% endif %}
      <video class="intro-image" style="aspect-ratio: {{ assets[feature.video].width }} / {{ assets[feature.video].height }}" data-home-video="{{ asset_url(feature.video) }}" data-home-poster="{{ poster_url(feature.video) }}" preload="none" loop muted playsinline aria-label="{{ feature.video_label }}" width="{{ assets[feature.video].width }}" height="{{ assets[feature.video].height }}"></video>
      <noscript><a href="{{ asset_url(feature.video) }}"><img class="intro-image" src="{{ poster_url(feature.video) }}" width="{{ assets[feature.video].width }}" height="{{ assets[feature.video].height }}" alt="{{ feature.video_label }}">{{ feature.title }}</a></noscript>
      {% if loop.index0 == 1 %}{{ feature_text(feature, loop.index0) }}{% endif %}
    </div>
  {% endfor %}
  </div>
</section>
<section data-md-color-scheme="slate" data-md-color-primary="grey" class="home-div">
  <div class="section-content" style="max-width: 90vw;">
  {% for group in locale.people %}
    <div style="margin: 2em auto;">
      <h3>{{ group.title }}</h3>
      {% if group.description %}<p>{{ group.description }}</p>{% endif %}
      {% if group.profiles %}<div class="profile-div">
      {% for person in group.profiles %}
        <div class="{{ person.class }}">
          {% if person.href %}<a href="{{ person.href }}">{% endif %}
            <img class="profile-img" {{ image(person.asset, true)|safe }} alt="{{ person.alt }}" decoding="async">
            <noscript><img class="profile-img" {{ image(person.asset)|safe }} alt="{{ person.alt }}" loading="lazy"></noscript>
            <br><b>{{ person.name }}</b>{% if person.detail %}<br><sub>{{ person.detail }}</sub>{% endif %}
          {% if person.href %}</a>{% endif %}
        </div>
      {% endfor %}
      </div>{% else %}<a href="{{ group.banner.href }}"><img data-home-src="{{ group.banner.url }}" alt="{{ group.banner.alt }}" style="{{ group.banner.style }}" decoding="async"><noscript><img src="{{ group.banner.url }}" alt="{{ group.banner.alt }}" style="{{ group.banner.style }}" loading="lazy"></noscript></a>{% endif %}
    </div>
  {% endfor %}
  </div>
</section>
<!-- This independent fallback also works when the deferred loader cannot be fetched. -->
<script src="{{ runtime('homepage-media.js') }}" defer onerror="document.querySelectorAll('[data-home-src], [data-home-poster]').forEach(function(el) { if (el.dataset.homeSrc) el.src = el.dataset.homeSrc; if (el.dataset.homePoster) el.poster = el.dataset.homePoster; });"></script>

<script>
// If the scene entry point itself fails, still provide chapter illustrations.
addEventListener('load', function () {
  if (!window.Starfield) document.querySelectorAll('[data-hero-fallback]').forEach(function (image) {
    image.src = image.dataset.heroFallback;
  });
}, {once: true});
</script>
