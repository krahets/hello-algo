  "frames": [
    {
      "id": "source-123",
      "book_path": "chapter_tree/binary_search_tree.assets/bst_remove_case2.png",
      "title": "二叉搜索树删除单子节点",
      "explanation": "删除值 2 时，沿 8 → 4 → 2 找到 cur = 2，父节点 pre = 4。节点 2 左为空、还有右子节点 3，度为 1。不能像删叶节点一样直接把 4.left 设为空，否则会从根断开本应保留的节点 3；应执行 pre.left = cur.right，将 4.left 指向 3。"
    }
  ],
