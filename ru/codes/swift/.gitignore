### Objective-C ###
# Xcode
#
# Авторам gitignore: не забудьте обновить Global/Xcode.gitignore, Objective-C.gitignore и Swift.gitignore

## Пользовательские настройки
xcuserdata/

## Для совместимости с Xcode 8 и более ранними версиями (начиная с Xcode 9 эти файлы можно не исключать)
*.xcscmblueprint
*.xccheckout

## Для совместимости с Xcode 3 и более ранними версиями (начиная с Xcode 4 эти файлы можно не исключать)
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Настройки для Objective-C и Swift
*.hmap

## Упаковка приложения
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
# Мы рекомендуем не добавлять каталог Pods в .gitignore. Однако
# решение остаётся за вами. Доводы за и против приведены здесь:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
# Pods/
# Добавьте эту строку, если хотите исключить из репозитория исходный код из рабочего пространства Xcode
# *.xcworkspace

# Carthage
# Добавьте эту строку, если хотите исключить из репозитория исходный код зависимостей Carthage.
# Carthage/Checkouts

Carthage/Build/

# fastlane
# Снимки экрана рекомендуется хранить вне репозитория Git.
# При необходимости их можно сгенерировать заново с помощью fastlane.
# Подробнее о рекомендуемой настройке:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Внедрение кода
# Новые инструменты внедрения кода создают каталог /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode

iOSInjectionProject/

